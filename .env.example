# Copy this file to .env and fill in your values.

# Local development (run `npm run pg` first):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/online_meal

# Hosted PostgreSQL (Neon, Supabase, Render, ...) looks like:
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/online_meal?sslmode=require

PORT=3000
